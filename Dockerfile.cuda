# syntax=docker/dockerfile:1
#
# PolyStrata on NVIDIA: the CUDA build. Upstream ships no CUDA Dockerfile at v0.2.20-poly.6 (only
# Dockerfile.rocm), so this file is ours.
#
# Two stages, because the card this runs on (RTX 2060, 6 GB) is on a node with a few GB free: the
# CUDA toolkit is only needed to compile strata-poly, and the runtime stage carries no compiler.
#
# strata-poly is the engine the Inkling family runs on (setup's "engine": "poly"); the qwen engine is
# not built here. The binary lands in terminal/engine-poly, where poly's setup expects it.
#
# Build (no GPU needed). The default targets sm_75:
#   docker build -f Dockerfile.cuda -t strata-poly:cuda .
#   docker build -f Dockerfile.cuda --build-arg CUDA_ARCHITECTURES=89 -t strata-poly:cuda .

ARG UBUNTU_VERSION=24.04
ARG CUDA_VERSION=12.8.1

FROM docker.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS build

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git libatomic1 libgomp1 \
        python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY . .

ARG CUDA_ARCHITECTURES=75

# 0.2.20 moved setup.py and the requirements under terminal/, so the build runs there: setup.ROOT is
# terminal/ and engine_src() resolves the cmake tree at /opt/strata/engine. STRATA_BUILD_POLY
# defaults ON and the vendored ggml is the default, so neither is passed.
RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r terminal/requirements.txt

WORKDIR /opt/strata/terminal
RUN CUDA_ARCHITECTURES="$CUDA_ARCHITECTURES" /opt/strata/.venv/bin/python - <<'PYEOF'
import json, os, shutil
import setup

src = setup.engine_src()
archs = [a for a in os.environ.get("CUDA_ARCHITECTURES", "75").replace(",", ";").split(";") if a]
nvcc = "/usr/local/cuda/bin/nvcc"
if not os.path.exists(nvcc):
    raise SystemExit(f"ERROR: no CUDA compiler at {nvcc}")

setup.cmake_build(src, setup.ROOT / "build-cuda", "strata-poly",
    ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_ENABLE_HIP=OFF", "-DSTRATA_BUILD_TESTS=OFF",
     "-DSTRATA_Q6K_EXPERTS=ON", "-DSTRATA_MMQ_KQUANTS=ON",
     "-DCMAKE_CUDA_ARCHITECTURES=" + ";".join(archs),
     f"-DCMAKE_CUDA_COMPILER={nvcc}", "-DSTRATA_PORTABLE=OFF"], None, "")

eng = setup.ROOT / setup.ENGINE_POLY_DIR
eng.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build-cuda" / setup.POLY_EXE, eng / setup.POLY_EXE)
meta = {"source": "local", "version": setup.source_version(), "archs": archs,
        "toolkit": 13 if min(int(a) for a in archs) >= 120 else 12,
        "cuda_dirs": [d for d in ("/usr/local/cuda/bin", "/usr/local/cuda/lib64") if os.path.isdir(d)],
        "src": setup.source_hash(setup.ENGINE_SOURCES), "vision": "none", "vision_src": None}
(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))
print("strata-poly built:", eng / setup.POLY_EXE)
PYEOF

RUN rm -rf terminal/build-cuda

FROM docker.io/nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

LABEL org.opencontainers.image.title="PolyStrata (CUDA)" \
      org.opencontainers.image.source="https://github.com/simplexai-labs/PolyStrata"

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8 STRATA_EXECV=1 BACKEND=cuda \
    PYTHONPATH=/opt/strata/terminal

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libatomic1 libgomp1 python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY --from=build /opt/strata /opt/strata
RUN chmod +x setup.sh tools/docker/entrypoint.sh \
    && test -x terminal/engine-poly/strata-poly

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./tools/docker/entrypoint.sh"]
